{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geelypassivekey-update",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "geelyupdate.mq.lucadesign.uk",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
